# Where content data is read from at build time.
#   file (default) — read from the checked-in JSON files in src/data/*
#   api            — fetch from DATA_API_BASE_URL instead, no rebuild needed
DATA_SOURCE=file

# Base URL used when DATA_SOURCE=api. Each data module appends its own
# resource path (e.g. education, experience, skills) to this base.
DATA_API_BASE_URL=https://api.pustalorc.com/dev
