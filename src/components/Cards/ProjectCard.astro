---
import type { Project } from '@models/Project';

import Badge from '@components/Badge/index.astro';
import { getStrings } from '@utils/i18n';
import { Icon } from 'astro-icon/components';

export interface Props {
  project: Project;
}

const { project } = Astro.props as Props;
const strings = getStrings(Astro.currentLocale);
---

<article class="panel panel-hover glow-border flex flex-col gap-3 p-6">
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h3 class="font-display text-xl font-semibold">{project.name}</h3>
    {project.license && <Badge>{project.license.id}</Badge>}
  </div>

  <p class="text-text-muted">{project.summary}</p>

  <details class="group">
    <summary
      class="mono text-accent-2 hover:text-accent w-fit cursor-pointer list-none text-xs uppercase tracking-wide"
    >
      <span class="group-open:hidden">{strings.cards.readMore}</span>
      <span class="hidden group-open:inline">{strings.cards.showLess}</span>
    </summary>
    <p class="text-text-muted mt-3 text-sm">{project.full}</p>
  </details>

  {
    project.href && (
      <a
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
        class="link mono mt-auto flex w-fit items-center gap-1 text-sm"
      >
        {strings.cards.viewSource}
        <Icon name="mingcute:external-link-line" class="h-3.5 w-3.5" />
      </a>
    )
  }
</article>
