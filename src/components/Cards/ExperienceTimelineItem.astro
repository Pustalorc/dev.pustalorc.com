---
import type Job from '@models/Job';

import Badge from '@components/Badge/index.astro';
import { formatMonthYearRange } from '@utils/dates';
import { getStrings } from '@utils/i18n';

export interface Props {
  job: Job;
  isLast?: boolean;
}

const { job, isLast } = Astro.props as Props;
const strings = getStrings(Astro.currentLocale);

const latestTitle = job.titles[0];
const earliestTitle = job.titles[job.titles.length - 1];
const isCurrent = latestTitle.endYear === null;
---

<div class="relative flex gap-4 pb-8">
  {!isLast && <span class="timeline-line" />}
  <span class:list={['timeline-dot', isCurrent && 'timeline-dot-current']}></span>

  <div class="flex flex-1 flex-col gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <h3 class="font-display text-lg font-semibold">{job.company}</h3>
      {isCurrent && <Badge class="text-accent border-accent">{strings.cards.current}</Badge>}
    </div>
    <p class="mono text-accent-2 text-xs">
      {
        formatMonthYearRange(
          earliestTitle.startMonth,
          earliestTitle.startYear,
          latestTitle.endMonth,
          latestTitle.endYear
        )
      }
    </p>
    <p class="text-text-muted text-sm">{job.summary}</p>

    <ul class="border-border mt-1 flex flex-col gap-2 border-l pl-4">
      {
        job.titles.map((title) => (
          <li>
            <p class="text-sm font-medium">{title.title}</p>
            <p class="mono text-text-muted text-xs">
              {formatMonthYearRange(
                title.startMonth,
                title.startYear,
                title.endMonth,
                title.endYear
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</div>
