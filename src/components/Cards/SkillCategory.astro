---
import type { SkillCategory } from '@models/Skill';

import { getStrings } from '@utils/i18n';
import { Icon } from 'astro-icon/components';

export interface Props {
  category: SkillCategory;
}

const { category } = Astro.props as Props;
const strings = getStrings(Astro.currentLocale);
---

<div class="panel flex flex-col gap-4 p-6 h-full">
  <h3 class="prompt">{category.category}</h3>
  <div class="flex flex-wrap gap-3">
    {
      category.skills.map((skill) => (
        <div
          class:list={[
            'flex items-center gap-2 rounded-md border px-3 py-2',
            skill.usedRecently ? 'border-border bg-bg-900' : 'border-border/60 bg-bg-900/40'
          ]}
        >
          <Icon
            name={skill.icon}
            class:list={[
              skill.usedRecently ? 'text-accent' : 'text-text-muted',
              'h-5 w-5 flex-none'
            ]}
          />
          <div class="flex flex-col leading-tight">
            <span class:list={['text-sm font-medium', !skill.usedRecently && 'text-text-muted']}>
              {skill.name}
            </span>
            <span
              class:list={[
                'mono text-xs',
                skill.usedRecently ? 'text-accent-2' : 'text-text-muted'
              ]}
            >
              {skill.usedRecently ? strings.cards.active : strings.cards.past}
            </span>
          </div>
        </div>
      ))
    }
  </div>
</div>
