{
  "name": "dev.pustalorc.com",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "description": "Vicente \"Pustalorc\" Pastor's developer portfolio and virtual curriculum",
  "author": "Vicente \"Pustalorc\" Pastor",
  "engines": {
    "node": ">=22.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run lint && astro build",
    "preview": "astro preview",
    "lint": "npm run lint:eslint && npm run lint:ts",
    "lint:eslint": "eslint . --ext .js,.mjs,.ts,.astro",
    "lint:ts": "tsc --noEmit",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix",
    "outdated": "npm outdated || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@iconify-json/ion": "1.2.7",
    "@iconify-json/mingcute": "1.2.8",
    "@iconify-json/simple-icons": "1.2.93",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.8",
    "astro-eslint-parser": "1.4.0",
    "astro-icon": "1.2.0",
    "astro-robots-txt": "1.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "73.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
