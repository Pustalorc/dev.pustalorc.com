{
  "name": "dev.pustalorc.com",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "description": "Vicente \"Pustalorc\" Pastor's developer portfolio and virtual curriculum",
  "author": "Vicente \"Pustalorc\" Pastor",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run lint && astro build",
    "preview": "npm run build && astro preview",
    "lint": "npm run lint:astro && npm run lint:eslint && npm run lint:ts",
    "lint:astro": "astro sync && astro check",
    "lint:eslint": "eslint . --ext .js,.mjs,.ts,.astro",
    "lint:ts": "tsc --noEmit",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@iconify-json/ion": "1.2.7",
    "@iconify-json/mingcute": "1.2.8",
    "@iconify-json/simple-icons": "1.2.99",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.6",
    "astro-eslint-parser": "3.2.0",
    "astro-icon": "1.2.0",
    "astro-robots-txt": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unicorn": "77.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
